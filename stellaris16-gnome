choose_btrfs_mount_opts(){
	options_btrfs_opts=()
	options_btrfs_opts+=("compress=zstd:1" "${txtbtrfsoptcompress}" on)
	options_btrfs_opts+=("nodatacow" "${txtbtrfsoptnodatacow}" off)
	options_btrfs_opts+=("nodatasum" "${txtbtrfsoptnodatasum}" off)
	sel_btrfs_opts=$(dialog --backtitle "${apptitle}" --title "${txtbtrfsmountopts}" --checklist "${txtbtrfsmountoptsdesc}" 0 0 0 \
		"${options_btrfs_opts[@]}" \
		3>&1 1>&2 2>&3)
	if [ "$?" = "0" ]; then
		btrfs_opts="rw,noatime,ssd,commit=120,space_cache=v2"
		for opt in ${sel_btrfs_opts}; do
			clean_opt=$(echo ${opt} | sed 's/"//g')
			btrfs_opts="${btrfs_opts},${clean_opt}"
		done
		btrfs_opts_configured=1
	fi
}

