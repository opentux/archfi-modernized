pressanykey(){
	read -n1 -p "${txtpressanykey}"
	echo ""
}

get_partition_name(){
	local dev="${1}"
	local pnum="${2}"
	if [[ "${dev}" =~ [0-9]$ ]]; then
		echo "${dev}p${pnum}"
	else
		echo "${dev}${pnum}"
	fi
}

get_parent_disk(){
	local part="${1}"
	local pkname
	pkname=$(lsblk -no pkname "${part}" 2>/dev/null | head -n 1)
	if [ -n "${pkname}" ]; then
		echo "/dev/${pkname}"
	elif [[ "${part}" =~ ^(/dev/nvme[0-9]+n[0-9]+)p[0-9]+$ ]]; then
		echo "${BASH_REMATCH[1]}"
	elif [[ "${part}" =~ ^(/dev/mmcblk[0-9]+)p[0-9]+$ ]]; then
		echo "${BASH_REMATCH[1]}"
	else
		echo "${part%%[0-9]*}"
	fi
}

optimize_pacman(){
	local conf="${1:-/etc/pacman.conf}"
	if [ -f "$conf" ]; then
		sed -i 's/^#Color/Color/' "$conf"
		grep -q "^Color" "$conf" || sed -i '/^#Misc options/a Color' "$conf"
		grep -q "ILoveCandy" "$conf" || sed -i '/Color/a ILoveCandy' "$conf"
		sed -i 's/^#VerbosePkgLists/VerbosePkgLists/' "$conf"
		if grep -q "ParallelDownloads" "$conf"; then
			sed -i 's/.*ParallelDownloads.*/ParallelDownloads = 10/' "$conf"
		else
			sed -i '/^Color/a ParallelDownloads = 10' "$conf"
		fi
		if grep -q "^#\[multilib\]" "$conf"; then
			sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' "$conf"
		elif ! grep -q "^\[multilib\]" "$conf"; then
			cat << 'EOF' >> "$conf"

[multilib]
Include = /etc/pacman.d/mirrorlist
EOF
		fi
	fi
}

