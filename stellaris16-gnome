# --------------------------------------------------------
# Select, Format & Mount Partitions
# --------------------------------------------------------
selectparts(){
	items=$(lsblk -p -n -l -o NAME -e 7,11)
	options=()
	for item in ${items}; do
		options+=("${item}" "")
	done

	bootdev=$(dialog --backtitle "${apptitle}" --title "${txtselectpartsmenu}" --default-item "${bootdev}" --menu "${txtselectdevice//%1/boot}" 0 0 0 \
		"none" "-" \
		"${options[@]}" \
		3>&1 1>&2 2>&3)
	if [ ! "$?" = "0" ]; then
		return 1
	else
		if [ "${bootdev}" = "none" ]; then
			bootdev=
		fi
	fi

	swapdev=$(dialog --backtitle "${apptitle}" --title "${txtselectpartsmenu}" --default-item "${swapdev}" --menu "${txtselectdevice//%1/swap}" 0 0 0 \
		"none" "-" \
		"${options[@]}" \
		3>&1 1>&2 2>&3)
	if [ ! "$?" = "0" ]; then
		return 1
	else
		if [ "${swapdev}" = "none" ]; then
			swapdev=
		fi
	fi

	rootdev=$(dialog --backtitle "${apptitle}" --title "${txtselectpartsmenu}" --default-item "${rootdev}" --menu "${txtselectdevice//%1/root}" 0 0 0 \
		"${options[@]}" \
		3>&1 1>&2 2>&3)
	if [ ! "$?" = "0" ]; then
		return 1
	fi
	realrootdev=${rootdev}

	homedev=$(dialog --backtitle "${apptitle}" --title "${txtselectpartsmenu}" --menu "${txtselectdevice//%1/home}" 0 0 0 \
		"none" "-" \
		"${options[@]}" \
		3>&1 1>&2 2>&3)
	if [ ! "$?" = "0" ]; then
		return 1
	else
		if [ "${homedev}" = "none" ]; then
			homedev=
		fi
	fi

	msg="${txtselecteddevices}\n\n"
	msg=${msg}"boot : "${bootdev}"\n"
	msg=${msg}"swap : "${swapdev}"\n"
	msg=${msg}"root : "${rootdev}"\n"
	msg=${msg}"home : "${homedev}"\n\n"
	if (dialog --backtitle "${apptitle}" --title "${txtselectpartsmenu}" --yesno "${msg}" 0 0) then
		isnvme=0
		if [ "${bootdev::8}" == "/dev/nvm" ] || [ "${rootdev::8}" == "/dev/nvm" ]; then
			isnvme=1
		fi
		mountmenu
	fi
}

mountmenu(){
	if [ "${1}" = "" ]; then
		nextitem="${txtformatdevices}"
	else
		nextitem=${1}
	fi
	options=()
	options+=("${txtformatdevices}" "")
	options+=("${txtmount}" "${txtmountdesc}")
	sel=$(dialog --backtitle "${apptitle}" --title "${txtformatmountmenu}" --cancel-button "${txtback}" --default-item "${nextitem}" --menu "" 0 0 0 \
		"${options[@]}" \
		3>&1 1>&2 2>&3)
	if [ "$?" = "0" ]; then
		case ${sel} in
			"${txtformatdevices}")
				formatdevices
				nextitem="${txtmount}"
			;;
			"${txtmount}")
				mountparts_and_run_auto
				return 0
			;;
		esac
		mountmenu "${nextitem}"
	fi
}

formatdevices(){
	if (dialog --backtitle "${apptitle}" --title "${txtformatdevices}" --defaultno --yesno "${txtformatdeviceconfirm}" 0 0); then
		fspkgs=""
		if [ ! "${bootdev}" = "" ]; then
			formatbootdevice boot ${bootdev} || return 1
		fi
		if [ ! "${swapdev}" = "" ]; then
			formatswapdevice swap ${swapdev} || return 1
		fi
		formatdevice root ${rootdev} || return 1
		if [ ! "${homedev}" = "" ]; then
			formatdevice home ${homedev} || return 1
		fi
	fi
}

formatbootdevice(){
	options=()
	if [ "${efimode}" = "1" ] || [ "${efimode}" = "2" ] || [ "${eficomputer}" = "1" ]; then
		options+=("fat32" "(EFI System Partition - Requis)")
	else
		options+=("ext4" "(Recommandé pour BIOS boot)")
		options+=("ext2" "")
		options+=("ext3" "")
		options+=("fat32" "")
	fi
	sel=$(dialog --backtitle "${apptitle}" --title "${txtformatbootdevice}" --menu "${txtselectpartformatboot//%1/${1} (${2})}" 0 0 0 \
		"${options[@]}" \
		3>&1 1>&2 2>&3)
	if [ ! "$?" = "0" ]; then
		return 1
	fi
	clear
	echo "${txtformatingpart//%1/${2}} ${sel}"
	echo "----------------------------------------------"
	case ${sel} in
		ext2) mkfs.ext2 ${2};;
		ext3) mkfs.ext3 ${2};;
		ext4) mkfs.ext4 ${2};;
		fat32)
			fspkgs="${fspkgs[@]} dosfstools"
			mkfs.fat -F32 ${2}
		;;
	esac
	echo ""
	pressanykey
}

formatswapdevice(){
	options=()
	options+=("swap" "")
	sel=$(dialog --backtitle "${apptitle}" --title "${txtformatdevice}" --menu "${txtselectpartformat//%1/${1} (${2})}" 0 0 0 \
		"${options[@]}" \
		3>&1 1>&2 2>&3)
	if [ ! "$?" = "0" ]; then
		return 1
	fi
	clear
	echo "${txtformatingpart//%1/${swapdev}} swap"
	echo "----------------------------------------------------"
	mkswap ${swapdev}
	echo ""
	pressanykey
	clear
}

formatdevice(){
	options=()
	options+=("btrfs" "(Moderne - Sous-volumes, compression zstd, mode Lab nodatacow)")
	options+=("ext4" "(Traditionnel stable)")
	options+=("xfs" "(Haute performance)")
	options+=("f2fs" "(Optimisé Flash/NVMe)")
	options+=("ext3" "")
	options+=("ext2" "")
	options+=("jfs" "")
	if [ ! "${3}" = "noluks" ]; then
		options+=("luks" "Chiffrement LUKS")
	fi

	local title="${txtformatdevice}"
	local prompt="${txtselectpartformat//%1/${1} (${2})}"
	if [ "${1}" = "root" ]; then
		title="${txtformatrootdevice}"
		prompt="${txtselectpartformatroot//%1/${1} (${2})}"
	fi

	sel=$(dialog --backtitle "${apptitle}" --title "${title}" --menu "${prompt}" 0 0 0 \
		"${options[@]}" \
		3>&1 1>&2 2>&3)
	if [ ! "$?" = "0" ]; then
		return 1
	fi
	clear
	echo "${txtformatingpart//%1/${2}} ${sel}"
	echo "----------------------------------------------"
	case ${sel} in
		btrfs)
			fspkgs="${fspkgs[@]} btrfs-progs"
			echo "mkfs.btrfs -f ${2}"
			mkfs.btrfs -f ${2}
			choose_btrfs_mount_opts
			if [ "${1}" = "root" ]; then
				options_btrfs=()
				if [[ "${btrfs_opts}" == *"nodatacow"* ]]; then
					options_btrfs+=("subvolumes_nosnap" "${txtbtrfssubvolsnosnap}")
					options_btrfs+=("subvolumes" "${txtbtrfssubvols}")
				else
					options_btrfs+=("subvolumes" "${txtbtrfssubvols}")
					options_btrfs+=("subvolumes_nosnap" "${txtbtrfssubvolsnosnap}")
				fi
				options_btrfs+=("simple" "${txtbtrfssimple}")
				btrfs_choice=$(dialog --backtitle "${apptitle}" --title "${txtbtrfslayout}" --menu "${txtbtrfsconfirm//%1/${2}}" 0 0 0 \
					"${options_btrfs[@]}" \
					3>&1 1>&2 2>&3)
				if [ "${btrfs_choice}" = "subvolumes" ]; then
					echo "Création des sous-volumes Btrfs (@, @home, @snapshots, @var_log, @pkg)..."
					mount ${2} /mnt
					btrfs subvolume create /mnt/@
					btrfs subvolume create /mnt/@home
					btrfs subvolume create /mnt/@snapshots
					btrfs subvolume create /mnt/@var_log
					btrfs subvolume create /mnt/@pkg
					umount /mnt
					btrfs_root_subvols=1
					btrfs_has_snapshots=1
				elif [ "${btrfs_choice}" = "subvolumes_nosnap" ]; then
					echo "Création des sous-volumes Btrfs sans snapshots (@, @home, @var_log, @pkg)..."
					mount ${2} /mnt
					btrfs subvolume create /mnt/@
					btrfs subvolume create /mnt/@home
					btrfs subvolume create /mnt/@var_log
					btrfs subvolume create /mnt/@pkg
					umount /mnt
					btrfs_root_subvols=1
					btrfs_has_snapshots=0
				else
					mount ${2} /mnt
					btrfs subvolume create /mnt/root
					btrfs subvolume set-default /mnt/root
					umount /mnt
					btrfs_root_subvols=0
					btrfs_has_snapshots=0
				fi
			fi
		;;
		ext4) mkfs.ext4 ${2};;
		ext3) mkfs.ext3 ${2};;
		ext2) mkfs.ext2 ${2};;
		xfs)
			fspkgs="${fspkgs[@]} xfsprogs"
			mkfs.xfs -f ${2}
		;;
		f2fs)
			fspkgs="${fspkgs[@]} f2fs-tools"
			mkfs.f2fs -f ${2}
		;;
		jfs)
			fspkgs="${fspkgs[@]} jfsutils"
			mkfs.jfs -f ${2}
		;;
		luks)
			echo "${txtcreateluksdevice}"
			cryptsetup luksFormat ${2}
			if [ ! "$?" = "0" ]; then
				pressanykey
				return 1
			fi
			echo "${txtopenluksdevice}"
			cryptsetup luksOpen ${2} ${1}
			if [ ! "$?" = "0" ]; then
				pressanykey
				return 1
			fi
			formatdevice ${1} /dev/mapper/${1} noluks
			if [ "${1}" = "root" ]; then
				realrootdev=${rootdev}
				rootdev=/dev/mapper/${1}
				luksroot=1
				luksrootuuid=$(cryptsetup luksUUID ${2})
			else
				case ${1} in
					home) homedev=/dev/mapper/${1} ;;
				esac
				luksdrive=1
				crypttab="\n${1}    UUID=$(cryptsetup luksUUID ${2})    none"
			fi
			echo "${txtluksdevicecreated}"
		;;
	esac
	echo ""
	pressanykey
}

# --------------------------------------------------------
# Mount Partitions -> Ask User Info -> Launch Unattended Install
# --------------------------------------------------------
mountparts_and_run_auto(){
	clear
	fstype=$(blkid -s TYPE -o value ${rootdev} 2>/dev/null)
	if [ "${fstype}" = "btrfs" ]; then
		mount ${rootdev} /mnt 2>/dev/null
		if [ -d "/mnt/@" ]; then
			btrfs_root_subvols=1
			if [ -d "/mnt/@snapshots" ]; then
				btrfs_has_snapshots=1
			else
				btrfs_has_snapshots=0
			fi
		fi
		umount /mnt 2>/dev/null
		if [ "${btrfs_opts_configured}" != "1" ]; then
			choose_btrfs_mount_opts
		fi
	fi

	if [ "${btrfs_root_subvols}" = "1" ]; then
		echo "mount -o ${btrfs_opts},subvol=@ ${rootdev} /mnt"
		mount -o ${btrfs_opts},subvol=@ ${rootdev} /mnt
		mkdir -p /mnt/{boot,home,var/log,var/cache/pacman/pkg}
		if [ -z "${homedev}" ]; then
			echo "mount -o ${btrfs_opts},subvol=@home ${rootdev} /mnt/home"
			mount -o ${btrfs_opts},subvol=@home ${rootdev} /mnt/home
		fi
		if [ "${btrfs_has_snapshots}" = "1" ]; then
			mkdir -p /mnt/.snapshots
			echo "mount -o ${btrfs_opts},subvol=@snapshots ${rootdev} /mnt/.snapshots"
			mount -o ${btrfs_opts},subvol=@snapshots ${rootdev} /mnt/.snapshots
		fi
		echo "mount -o ${btrfs_opts},subvol=@var_log ${rootdev} /mnt/var/log"
		mount -o ${btrfs_opts},subvol=@var_log ${rootdev} /mnt/var/log
		echo "mount -o ${btrfs_opts},subvol=@pkg ${rootdev} /mnt/var/cache/pacman/pkg"
		mount -o ${btrfs_opts},subvol=@pkg ${rootdev} /mnt/var/cache/pacman/pkg
	else
		if [ "${fstype}" = "btrfs" ]; then
			echo "mount -o ${btrfs_opts} ${rootdev} /mnt"
			mount -o ${btrfs_opts} ${rootdev} /mnt
		elif [ "${fstype}" = "ext4" ] || [ "${fstype}" = "xfs" ]; then
			echo "mount -o rw,noatime ${rootdev} /mnt"
			mount -o rw,noatime ${rootdev} /mnt
		else
			echo "mount ${rootdev} /mnt"
			mount ${rootdev} /mnt
		fi
		mkdir -p /mnt/{boot,home} 2>/dev/null
	fi

	if [ ! "${bootdev}" = "" ]; then
		mkdir -p /mnt/boot
		echo "mount ${bootdev} /mnt/boot"
		mount ${bootdev} /mnt/boot
	fi
	if [ ! "${swapdev}" = "" ]; then
		echo "swapon ${swapdev}"
		swapon ${swapdev}
	fi
	if [ ! "${homedev}" = "" ]; then
		home_fstype=$(blkid -s TYPE -o value ${homedev} 2>/dev/null)
		mkdir -p /mnt/home
		if [ "${home_fstype}" = "btrfs" ]; then
			mount -o ${btrfs_opts} ${homedev} /mnt/home
		elif [ "${home_fstype}" = "ext4" ] || [ "${home_fstype}" = "xfs" ]; then
			mount -o rw,noatime ${homedev} /mnt/home
		else
			mount ${homedev} /mnt/home
		fi
	fi

	# Collect user credentials right now so the rest of the installation is 100% unattended
	collect_user_and_system_inputs || return 1

	# Launch full automatic installation
	run_full_automatic_install
}

collect_user_and_system_inputs(){
	# 1. Hostname
	local hname
	hname=$(dialog --backtitle "${apptitle}" --title "Nom de la machine (Hostname)" \
		--inputbox "Entrez le nom d'hôte du TUXEDO Stellaris 16 :" 0 0 "${target_hostname}" 3>&1 1>&2 2>&3)
	if [ "$?" = "0" ] && [ -n "${hname}" ]; then
		target_hostname="${hname}"
	fi

	# 2. Username
	while true; do
		target_user=$(dialog --backtitle "${apptitle}" --title "Création de l'utilisateur" \
			--inputbox "Entrez le nom de votre compte utilisateur (ex: opentux) :" 0 0 "opentux" 3>&1 1>&2 2>&3)
		if [ "$?" != "0" ]; then
			return 1
		fi
		if [ -n "${target_user}" ]; then
			break
		fi
	done

	# 3. User password (with confirmation)
	while true; do
		local p1 p2
		p1=$(dialog --backtitle "${apptitle}" --title "Mot de passe pour ${target_user}" \
			--insecure --passwordbox "Entrez le mot de passe pour l'utilisateur ${target_user} :" 0 0 3>&1 1>&2 2>&3)
		if [ "$?" != "0" ]; then
			return 1
		fi
		p2=$(dialog --backtitle "${apptitle}" --title "Confirmation du mot de passe" \
			--insecure --passwordbox "Confirmez le mot de passe pour ${target_user} :" 0 0 3>&1 1>&2 2>&3)
		if [ "$?" != "0" ]; then
			return 1
		fi
		if [ -n "${p1}" ] && [ "${p1}" = "${p2}" ]; then
			target_user_pass="${p1}"
			break
		else
			dialog --backtitle "${apptitle}" --title "Erreur" --msgbox "Les mots de passe ne correspondent pas ou sont vides. Veuillez réessayer." 0 0
		fi
	done

	# 4. Root password (same as user or custom)
	if (dialog --backtitle "${apptitle}" --title "Mot de passe Root" \
		--yesno "Utiliser le même mot de passe que '${target_user}' pour le compte administrateur (root) ?" 0 0); then
		target_root_pass="${target_user_pass}"
	else
		while true; do
			local rp1 rp2
			rp1=$(dialog --backtitle "${apptitle}" --title "Mot de passe Root" \
				--insecure --passwordbox "Entrez le mot de passe pour root :" 0 0 3>&1 1>&2 2>&3)
			rp2=$(dialog --backtitle "${apptitle}" --title "Confirmation Mot de passe Root" \
				--insecure --passwordbox "Confirmez le mot de passe pour root :" 0 0 3>&1 1>&2 2>&3)
			if [ -n "${rp1}" ] && [ "${rp1}" = "${rp2}" ]; then
				target_root_pass="${rp1}"
				break
			else
				dialog --backtitle "${apptitle}" --title "Erreur" --msgbox "Les mots de passe root ne correspondent pas ou sont vides." 0 0
			fi
		done
	fi

	# 5. Passwordless sudo (NOPASSWD)
	if (dialog --backtitle "${apptitle}" --title "Privilèges Sudo" \
		--yesno "Activer sudo sans mot de passe (NOPASSWD) dans /etc/sudoers.d/${target_user} ?\n\n(Recommandé : Oui)" 0 0); then
		target_user_nopasswd="1"
	else
		target_user_nopasswd="0"
	fi

	# 6. Bootloader choice (GRUB EFI default, rEFInd or systemd-boot)
	local bl_options=()
	bl_options+=("grub" "GRUB EFI (Recommandé)")
	bl_options+=("refind" "rEFInd EFI (Menu graphique moderne)")
	bl_options+=("systemd-boot" "systemd-boot EFI")
	target_bootloader=$(dialog --backtitle "${apptitle}" --title "Chargeur d'amorçage (Bootloader)" \
		--default-item "grub" --menu "Choisissez le bootloader à installer automatiquement :" 0 0 0 \
		"${bl_options[@]}" 3>&1 1>&2 2>&3)
	if [ "$?" != "0" ] || [ -z "${target_bootloader}" ]; then
		target_bootloader="grub"
	fi

	return 0
}

# --------------------------------------------------------
# Full Automatic Unattended Installation Engine
# --------------------------------------------------------
run_full_automatic_install(){
	clear
	echo "=============================================================================="
	echo " LANCEMENT DE L'INSTALLATION AUTOMATIQUE — TUXEDO STELLARIS 16 (GNOME)"
	echo "=============================================================================="
	echo " - Machine      : ${target_hostname}"
	echo " - Utilisateur  : ${target_user} (NOPASSWD=${target_user_nopasswd})"
	echo " - Locale / Kbd : fr_FR.UTF-8 / Clavier AZERTY (fr) / Europe/Paris (UTC)"
	echo " - Noyau        : linux-cachyos + headers + dkms + cachyos-settings"
	echo " - Stockage     : Samsung 990 Pro NVMe + Scheduler I/O ADIOS + fstrim.timer"
	echo " - RAM          : 96 Go + ZRAM (zstd, swappiness=180)"
	echo " - GPU          : Intel 275HX + NVIDIA RTX 5090 175W (nvidia-open + CUDA + PRIME)"
	echo " - TUXEDO       : tuxedo-drivers-dkms + tuxedo-control-center-bin + tccd"
	echo " - Bureau       : GNOME + AppIndicator + Extension Manager + adw-gtk3-dark"
	echo " - Gaming/Outils: CachyOS Gaming Meta/Apps + Proton/Wine CachyOS + Outils GUI CachyOS"
	echo " - Bootloader   : ${target_bootloader} + Plymouth (spinner) + mkinitcpio LZ4"
	echo "=============================================================================="
	echo ""

	# ------------------------------------------------------------------
	# [1/14] Reflector: Germany,France — 15 fastest HTTPS mirrors
	# ------------------------------------------------------------------
	echo ">>> [1/14] Optimisation des miroirs Pacman avec Reflector (Germany, France - 15 miroirs)..."
	pacman -S --needed --noconfirm reflector 2>/dev/null || true
	if command -v reflector >/dev/null 2>&1; then
		reflector --country Germany,France --latest 15 --protocol https --sort rate --save /etc/pacman.d/mirrorlist || true
	fi

	# ------------------------------------------------------------------
	# [2/14] CachyOS Repositories + Pacman Optimization (Parallel=10, Color, Multilib)
	# ------------------------------------------------------------------
	echo ">>> [2/14] Configuration de Pacman (ParallelDownloads=10, Color, Multilib) & Dépôts CachyOS..."
	optimize_pacman "/etc/pacman.conf"

	cachy_arch="v3"
	if /usr/lib/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q "x86-64-v4 (supported"; then
		cachy_arch="v4"
	elif /usr/lib/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q "x86-64-v3 (supported"; then
		cachy_arch="v3"
	elif grep -q "avx512f" /proc/cpuinfo 2>/dev/null && grep -q "avx512bw" /proc/cpuinfo 2>/dev/null; then
		cachy_arch="v4"
	fi
	echo "Architecture CPU détectée : ${cachy_arch}"

	pacman-key --recv-keys F3B607488DB35A47 --keyserver keyserver.ubuntu.com 2>/dev/null || \
	pacman-key --recv-keys F3B607488DB35A47 --keyserver hkps://keyserver.ubuntu.com 2>/dev/null || true
	pacman-key --lsign-key F3B607488DB35A47 2>/dev/null || true

	mkdir -p /etc/pacman.d
	cat << 'EOF' > /etc/pacman.d/cachyos-mirrorlist
Server = https://mirror.cachyos.org/repo/x86_64/$repo
Server = https://fastmirror.cachyos.org/repo/x86_64/$repo
Server = https://in-mirror.cachyos.org/repo/x86_64/$repo
Server = https://cdn77.cachyos.org/repo/x86_64/$repo
EOF

	if [ "${cachy_arch}" = "v4" ]; then
		sed -i 's/^#*Architecture\s*=.*/Architecture = auto x86_64 x86_64_v3 x86_64_v4/' /etc/pacman.conf
		cat << 'EOF' > /etc/pacman.d/cachyos-v4-mirrorlist
Server = https://mirror.cachyos.org/repo/x86_64_v4/$repo
Server = https://fastmirror.cachyos.org/repo/x86_64_v4/$repo
Server = https://in-mirror.cachyos.org/repo/x86_64_v4/$repo
Server = https://cdn77.cachyos.org/repo/x86_64_v4/$repo
EOF
		cat << 'EOF' > /tmp/cachyos-repos.conf
[cachyos-v4]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v4-mirrorlist

[cachyos-core-v4]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v4-mirrorlist

[cachyos-extra-v4]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v4-mirrorlist

[cachyos]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-mirrorlist

EOF
	else
		sed -i 's/^#*Architecture\s*=.*/Architecture = auto x86_64 x86_64_v3/' /etc/pacman.conf
		cat << 'EOF' > /etc/pacman.d/cachyos-v3-mirrorlist
Server = https://mirror.cachyos.org/repo/x86_64_v3/$repo
Server = https://fastmirror.cachyos.org/repo/x86_64_v3/$repo
Server = https://in-mirror.cachyos.org/repo/x86_64_v3/$repo
Server = https://cdn77.cachyos.org/repo/x86_64_v3/$repo
EOF
		cat << 'EOF' > /tmp/cachyos-repos.conf
[cachyos-v3]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos-core-v3]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos-extra-v3]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-mirrorlist

EOF
	fi

	sed -i '/^\[cachyos/,/^\[core\]/{ /^\[core\]/!d }' /etc/pacman.conf 2>/dev/null || true
	sed -i '/^\[core\]/e cat /tmp/cachyos-repos.conf' /etc/pacman.conf
	rm -f /tmp/cachyos-repos.conf
	pacman -Sy

	# ------------------------------------------------------------------
	# [3/14] Pacstrap Base System + CachyOS Kernel + Headers + DKMS
	# ------------------------------------------------------------------
	echo ">>> [3/14] Installation du système de base et du noyau CachyOS (pacstrap)..."
	local mirrorlist_pkg="cachyos-v3-mirrorlist"
	if [ "${cachy_arch}" = "v4" ]; then
		mirrorlist_pkg="cachyos-v4-mirrorlist"
	fi

	local base_pkgs="base base-devel linux-cachyos linux-cachyos-headers dkms linux-firmware intel-ucode"
	base_pkgs+=" cachyos-keyring cachyos-mirrorlist ${mirrorlist_pkg} cachyos-settings"
	base_pkgs+=" zram-generator plymouth lz4 btrfs-progs dosfstools xfsprogs f2fs-tools efibootmgr grub"
	base_pkgs+=" networkmanager iwd wireless-regdb sudo git wget curl nano vim bash-completion pacman-contrib reflector"

	pacstrap /mnt ${base_pkgs}
	local pacstrap_status=$?
	if [ ${pacstrap_status} -ne 0 ]; then
		echo "ERREUR CRITIQUE : pacstrap a échoué avec le code ${pacstrap_status}."
		pressanykey
		return 1
	fi

	# Propagate Pacman config, CachyOS repos, and Reflector mirrorlist into /mnt
	optimize_pacman "/mnt/etc/pacman.conf"
	mkdir -p /mnt/etc/pacman.d
	cp -f /etc/pacman.d/mirrorlist /mnt/etc/pacman.d/mirrorlist 2>/dev/null || true
	cp -f /etc/pacman.d/cachyos* /mnt/etc/pacman.d/ 2>/dev/null || true
	sed -i 's|/\$arch_v3/|/x86_64_v3/|g; s|/\$arch/|/x86_64_v3/|g' /mnt/etc/pacman.d/cachyos-v3-mirrorlist 2>/dev/null || true
	sed -i 's|/\$arch_v4/|/x86_64_v4/|g; s|/\$arch/|/x86_64_v4/|g' /mnt/etc/pacman.d/cachyos-v4-mirrorlist 2>/dev/null || true

	local host_arch_line
	host_arch_line=$(grep "^Architecture" /etc/pacman.conf | head -n 1)
	if [ -n "${host_arch_line}" ]; then
		sed -i "s/^#*Architecture\s*=.*/${host_arch_line}/" /mnt/etc/pacman.conf
	fi
	sed -i '/^\[cachyos/,/^\[core\]/{ /^\[core\]/!d }' /mnt/etc/pacman.conf 2>/dev/null || true
	sed -n '/^\[cachyos/,/^\[core\]/{ /^\[core\]/!p }' /etc/pacman.conf > /tmp/mnt-cachyos.conf
	sed -i '/^\[core\]/e cat /tmp/mnt-cachyos.conf' /mnt/etc/pacman.conf
	rm -f /tmp/mnt-cachyos.conf

	arch-chroot /mnt pacman-key --recv-keys F3B607488DB35A47 --keyserver keyserver.ubuntu.com 2>/dev/null || true
	arch-chroot /mnt pacman-key --lsign-key F3B607488DB35A47 2>/dev/null || true
	arch-chroot /mnt pacman-key --populate archlinux cachyos 2>/dev/null || true
	arch-chroot /mnt pacman -Sy

	# ------------------------------------------------------------------
	# [4/14] fstab & crypttab
	# ------------------------------------------------------------------
	echo ">>> [4/14] Génération de /etc/fstab (UUID)..."
	genfstab -U -p /mnt > /mnt/etc/fstab
	if [ "${luksdrive}" = "1" ] && [ -n "${crypttab}" ]; then
		echo -e "${crypttab}" >> /mnt/etc/crypttab
	fi

	# ------------------------------------------------------------------
	# [5/14] Timezone (Europe/Paris), UTC Hardware Clock, NTP & Hostname
	# ------------------------------------------------------------------
	echo ">>> [5/14] Configuration du fuseau horaire (Europe/Paris, UTC) et du nom d'hôte (${target_hostname})..."
	ln -sf /usr/share/zoneinfo/Europe/Paris /mnt/etc/localtime
	arch-chroot /mnt hwclock --systohc --utc
	arch-chroot /mnt systemctl enable systemd-timesyncd.service 2>/dev/null || true

	echo "${target_hostname}" > /mnt/etc/hostname
	cat << EOF > /mnt/etc/hosts
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${target_hostname}.localdomain ${target_hostname}
EOF

	# ------------------------------------------------------------------
	# [6/14] Full French Locale (fr_FR.UTF-8) & AZERTY Keyboard (fr)
	# ------------------------------------------------------------------
	echo ">>> [6/14] Configuration intégrale de la langue française (fr_FR.UTF-8) et du clavier AZERTY (fr)..."
	sed -i 's/^#\(fr_FR.UTF-8 UTF-8\)/\1/' /mnt/etc/locale.gen
	sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' /mnt/etc/locale.gen
	arch-chroot /mnt locale-gen

	cat << 'EOF' > /mnt/etc/locale.conf
LANG=fr_FR.UTF-8
LC_COLLATE=C
EOF
	grep -q "^LANG=" /mnt/etc/environment 2>/dev/null || echo "LANG=fr_FR.UTF-8" >> /mnt/etc/environment
	echo "KEYMAP=fr" > /mnt/etc/vconsole.conf

	mkdir -p /mnt/etc/X11/xorg.conf.d /mnt/etc/xdg /mnt/etc/skel/.config
	cat << 'EOF' > /mnt/etc/X11/xorg.conf.d/00-keyboard.conf
Section "InputClass"
        Identifier "system-keyboard"
        MatchIsKeyboard "on"
        Option "XkbLayout" "fr"
        Option "XkbModel" "pc105"
EndSection
EOF

	mkdir -p /mnt/etc/dconf/profile /mnt/etc/dconf/db/local.d
	cat << 'EOF' > /mnt/etc/dconf/profile/user
user-db:user
system-db:local
EOF
	cat << 'EOF' > /mnt/etc/dconf/db/local.d/00-keyboard
[org/gnome/desktop/input-sources]
sources=[('xkb', 'fr')]
mru-sources=[('xkb', 'fr')]

[org/gnome/shell]
disable-user-extensions=false
enabled-extensions=['appindicatorsupport@rgcjonas.gmail.com']

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
EOF

	# Configure GTK3 & GTK4 dark theme (adw-gtk3-dark) for legacy windows in /etc/skel
	mkdir -p /mnt/etc/skel/.config/gtk-3.0 /mnt/etc/skel/.config/gtk-4.0
	cat << 'EOF' > /mnt/etc/skel/.config/gtk-3.0/settings.ini
[Settings]
gtk-theme-name=adw-gtk3-dark
gtk-application-prefer-dark-theme=1
EOF
	cat << 'EOF' > /mnt/etc/skel/.config/gtk-4.0/settings.ini
[Settings]
gtk-theme-name=adw-gtk3-dark
gtk-application-prefer-dark-theme=1
EOF

	# ------------------------------------------------------------------
	# [7/14] Root & User Creation + Sudoers + Fastfetch in .bashrc
	# ------------------------------------------------------------------
	echo ">>> [7/14] Création des comptes root et ${target_user} + configuration sudoers et fastfetch..."
