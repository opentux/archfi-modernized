diskpartautodos(){
	device=$(selectdisk "${txtautoparts} (dos)")
	if [ "$?" = "0" ]; then
		if (dialog --backtitle "${apptitle}" --title "${txtautoparts} (dos)" --defaultno --yesno "${txtautopartsconfirm//%1/${device}}" 0 0) then
			want_swap="0"
			if (dialog --backtitle "${apptitle}" --title "${txtautoparts} (dos)" --defaultno --yesno "${txtcreateswap}" 0 0); then
				want_swap="1"
			fi
			clear
			echo "${txtautopartclear}"
			parted ${device} mklabel msdos
			sleep 1
			echo "${txtautopartcreate//%1/boot (1GB)}"
			echo -e "n\np\n1\n\n+1024M\na\nw" | fdisk ${device}
			sleep 1
			if [ "${want_swap}" = "1" ]; then
				echo "${txtautopartcreate//%1/swap}"
				swapsize=$(cat /proc/meminfo | grep MemTotal | awk '{ print $2 }')
				swapsize=$((${swapsize}/1000))"M"
				echo -e "n\np\n2\n\n+${swapsize}\nt\n2\n82\nw" | fdisk ${device}
				sleep 1
				echo "${txtautopartcreate//%1/root}"
				echo -e "n\np\n3\n\n\nw" | fdisk ${device}
				bootdev=$(get_partition_name "${device}" 1)
				swapdev=$(get_partition_name "${device}" 2)
				rootdev=$(get_partition_name "${device}" 3)
			else
				echo "${txtautopartcreate//%1/root}"
				echo -e "n\np\n2\n\n\nw" | fdisk ${device}
				bootdev=$(get_partition_name "${device}" 1)
				swapdev=""
				rootdev=$(get_partition_name "${device}" 2)
			fi
			sleep 1
			echo ""
			pressanykey
			efimode="0"
		fi
	fi
}

diskpartautogpt(){
	device=$(selectdisk "${txtautoparts} (gpt)")
	if [ "$?" = "0" ]; then
		if (dialog --backtitle "${apptitle}" --title "${txtautoparts} (gpt)" --defaultno --yesno "${txtautopartsconfirm//%1/${device}}" 0 0) then
			want_swap="0"
			if (dialog --backtitle "${apptitle}" --title "${txtautoparts} (gpt)" --defaultno --yesno "${txtcreateswap}" 0 0); then
