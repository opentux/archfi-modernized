	echo ""
	echo "=============================================================================="
	echo " INSTALLATION AUTOMATIQUE TERMINÉE AVEC SUCCÈS ! (GNOME)"
	echo "=============================================================================="
	pressanykey

	if (dialog --backtitle "${apptitle}" --title "Installation Terminée" \
		--yesno "L'installation complète du TUXEDO Stellaris 16 (GNOME) est terminée !\n\nVoulez-vous démonter les partitions et redémarrer maintenant ?" 0 0); then
		clear
		umount -R /mnt 2>/dev/null || true
		swapoff -a 2>/dev/null || true
		reboot
	fi
}

# --------------------------------------------------------
# Entry Point (French initialization out of the box)
# --------------------------------------------------------
echo "Initialisation en Français (Clavier AZERTY fr, locale fr_FR.UTF-8, Pacman)..."
loadkeys fr 2>/dev/null || true
if [ -f /etc/locale.gen ]; then
	sed -i 's/^#\(fr_FR.UTF-8 UTF-8\)/\1/' /etc/locale.gen
	sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
	locale-gen >/dev/null 2>&1 || true
fi
export LANG=fr_FR.UTF-8

optimize_pacman "/etc/pacman.conf"
systemctl start pacman-init.service 2>/dev/null || true
pacman -Sy --noconfirm archlinux-keyring 2>/dev/null || true
pacman -S --needed --noconfirm arch-install-scripts dialog

if [ -d /sys/firmware/efi/efivars ]; then
	eficomputer=1
	efimode=1
else
	eficomputer=0
	efimode=0
fi

cat << 'EOF' > dialog.stellaris
use_shadow = OFF
title_color = (BLACK,WHITE,OFF)
button_label_active_color = (WHITE,BLUE,ON)
button_label_inactive_color = (BLACK,WHITE,OFF)
tag_color = (BLACK,WHITE,OFF)
tag_selected_color = (WHITE,BLUE,ON)
tag_key_color = (BLACK,WHITE,OFF)
tag_key_selected_color = (WHITE,BLUE,ON)
check_color = tag_color
check_selected_color = tag_selected_color
EOF
export DIALOGRC="dialog.stellaris"

load_french_strings
EDITOR=nano
mainmenu
rm -f dialog.stellaris
exit 0
