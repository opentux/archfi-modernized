# Module: GPU Drivers
# --------------------------------------------------------
menu_gpu(){
    detected_gpu=$(lspci 2>/dev/null | grep -E "VGA|3D|Display")
    
    options=()
    options+=("hybrid-intel-nvidia" "${txtgpuhybridintel}")
    options+=("hybrid-amd-nvidia" "${txtgpuhybridamd}")
    options+=("nvidia-open" "${txtgpunvidiaopen}")
    options+=("nvidia-dkms" "${txtgpunvidiadkms}")
    options+=("intel" "${txtgpuintel}")
    options+=("amd" "${txtgpuamd}")
    options+=("vm" "${txtgpuvm}")
    
    sel=$(dialog --backtitle "${apptitle}" --title "${txtgputitle}" \
        --menu "${txtgpudesc}\nDetected: ${detected_gpu}" 0 0 0 \
        "${options[@]}" \
        3>&1 1>&2 2>&3)
        
    if [ "$?" = "0" ]; then
        clear
        local nv_open_pkg="nvidia-open"
        if pacman -Q linux-zen linux-lts linux-hardened &>/dev/null || ! pacman -Q linux &>/dev/null; then
            echo "Alternative kernel detected (linux-zen/lts/hardened). Using nvidia-open-dkms to prevent pulling standard linux kernel..."
            nv_open_pkg="nvidia-open-dkms"
            install_kernel_headers_and_dkms
        fi

        case ${sel} in
            "hybrid-intel-nvidia")
                echo "Installing Hybrid Laptop Intel + NVIDIA Open (${nv_open_pkg} + prime-run)..."
                pacman -S --needed --noconfirm \
                    mesa lib32-mesa \
                    intel-media-driver \
                    vulkan-intel lib32-vulkan-intel \
                    "${nv_open_pkg}" nvidia-utils lib32-nvidia-utils nvidia-settings \
                    nvidia-prime
            ;;
            "hybrid-amd-nvidia")
                echo "Installing Hybrid Laptop AMD + NVIDIA Open (${nv_open_pkg} + prime-run)..."
                pacman -S --needed --noconfirm \
                    mesa lib32-mesa \
                    xf86-video-amdgpu \
                    vulkan-radeon lib32-vulkan-radeon \
                    "${nv_open_pkg}" nvidia-utils lib32-nvidia-utils nvidia-settings \
                    nvidia-prime
            ;;
            "nvidia-open")
                echo "Installing NVIDIA Open drivers (${nv_open_pkg})..."
                pacman -S --needed --noconfirm "${nv_open_pkg}" nvidia-utils lib32-nvidia-utils nvidia-settings
            ;;
            "nvidia-dkms")
                echo "Installing NVIDIA Proprietary DKMS drivers..."
                install_kernel_headers_and_dkms
                pacman -S --needed --noconfirm nvidia-dkms nvidia-utils lib32-nvidia-utils nvidia-settings
            ;;
            "intel")
                echo "Installing Intel Graphics drivers..."
                pacman -S --needed --noconfirm mesa lib32-mesa intel-media-driver vulkan-intel lib32-vulkan-intel
            ;;
            "amd")
                echo "Installing AMD Radeon drivers..."
                pacman -S --needed --noconfirm mesa lib32-mesa xf86-video-amdgpu vulkan-radeon lib32-vulkan-radeon
            ;;
            "vm")
                echo "Installing VM guest tools..."
                pacman -S --needed --noconfirm virtualbox-guest-utils qemu-guest-agent spice-vdagent
                systemctl enable vboxservice.service 2>/dev/null || true
                systemctl enable qemu-guest-agent.service 2>/dev/null || true
            ;;
        esac
        pressanykey
    fi
}

