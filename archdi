    options+=("flatpak" "Flatpak + Flathub & GUI Software Store integration" on)
    options+=("snapper" "Btrfs Snapshots (snapper + snap-pac + btrfs-assistant)" off)
    options+=("ufw" "Uncomplicated Firewall" off)
    
    sel=$(dialog --backtitle "${apptitle}" --title "${txtservicestitle}" --checklist "${txtservicesdesc}" 0 0 0 \
