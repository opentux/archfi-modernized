configure_fastfetch_bashrc(){
    echo "Configuring fastfetch to run automatically on terminal startup..."
    local snippet='
# Autostart fastfetch on interactive shell launch
if [[ $- == *i* ]] && command -v fastfetch >/dev/null 2>&1; then
    fastfetch
fi'

    mkdir -p /etc/skel
    if [ ! -f /etc/bash.bashrc ]; then
        echo "${snippet}" > /etc/bash.bashrc
    elif ! grep -q "Autostart fastfetch" /etc/bash.bashrc; then
        echo "${snippet}" >> /etc/bash.bashrc
    fi

    if [ -f /etc/skel/.bashrc ] && ! grep -q "Autostart fastfetch" /etc/skel/.bashrc; then
        echo "${snippet}" >> /etc/skel/.bashrc
    elif [ ! -f /etc/skel/.bashrc ]; then
        echo "${snippet}" > /etc/skel/.bashrc
    fi

    if [ -f /root/.bashrc ] && ! grep -q "Autostart fastfetch" /root/.bashrc; then
        echo "${snippet}" >> /root/.bashrc
    fi

    for u_home in /home/*; do
        if [ -d "${u_home}" ]; then
            local u_name
            u_name=$(basename "${u_home}")
            if [ -f "${u_home}/.bashrc" ] && ! grep -q "Autostart fastfetch" "${u_home}/.bashrc"; then
                echo "${snippet}" >> "${u_home}/.bashrc"
                chown "${u_name}" "${u_home}/.bashrc" 2>/dev/null || true
            elif [ ! -f "${u_home}/.bashrc" ]; then
                echo "${snippet}" > "${u_home}/.bashrc"
                chown "${u_name}" "${u_home}/.bashrc" 2>/dev/null || true
            fi
        fi
    done
}

