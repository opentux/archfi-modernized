# --------------------------------------------------------
# Module: Pacman Optimization & Multilib
# --------------------------------------------------------
optimize_pacman(){
    local conf="${1:-/etc/pacman.conf}"
    if [ -f "$conf" ]; then
        # Enable Color
        sed -i 's/^#Color/Color/' "$conf"
        grep -q "^Color" "$conf" || sed -i '/^#Misc options/a Color' "$conf"
        
        # Enable ILoveCandy
        grep -q "ILoveCandy" "$conf" || sed -i '/Color/a ILoveCandy' "$conf"
        
        # Enable VerbosePkgLists
        sed -i 's/^#VerbosePkgLists/VerbosePkgLists/' "$conf"
        
        # Set ParallelDownloads = 10
        if grep -q "ParallelDownloads" "$conf"; then
            sed -i 's/.*ParallelDownloads.*/ParallelDownloads = 10/' "$conf"
        else
            sed -i '/^Color/a ParallelDownloads = 10' "$conf"
        fi
        
        # Enable multilib
        if grep -q "^#\[multilib\]" "$conf"; then
            sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' "$conf"
        elif ! grep -q "^\[multilib\]" "$conf"; then
            cat << 'EOF' >> "$conf"

[multilib]
Include = /etc/pacman.d/mirrorlist
EOF
        fi
    fi
}

menu_pacman(){
    if dialog --backtitle "${apptitle}" --title "${txtpacmantitle}" --yesno "${txtpacmandesc}" 0 0; then
        clear
        echo "Optimizing /etc/pacman.conf (Color, ILoveCandy, ParallelDownloads=10, Multilib)..."
        optimize_pacman "/etc/pacman.conf"
        echo "Refreshing Pacman database with multilib..."
        pacman -Sy
        dialog --backtitle "${apptitle}" --title "Success" --msgbox "${txtpacmansuccess}" 0 0
    fi
}

# --------------------------------------------------------
# Module: User Management
# --------------------------------------------------------
menu_user(){
    username=$(dialog --backtitle "${apptitle}" --title "${txtusermenu}" --inputbox "${txtusernameprompt}" 0 0 3>&1 1>&2 2>&3)
    if [ "$?" = "0" ] && [ -n "${username}" ]; then
        if id "${username}" &>/dev/null; then
            dialog --backtitle "${apptitle}" --title "Error" --msgbox "User ${username} already exists!" 0 0
            return 1
        fi

        local nopasswd="0"
        if (dialog --backtitle "${apptitle}" --title "${txtusermenu}" --yesno "${txtusersudoersnopasswd//%1/${username}}" 0 0); then
            nopasswd="1"
        fi

        clear
        echo "Installing sudo..."
        pacman -S --needed --noconfirm sudo
        echo "Creating user ${username}..."
        useradd -m -G wheel -s /bin/bash "${username}"
        echo "Please set password for ${username}:"
        passwd "${username}"
        
        # Configure sudoers for wheel
        if [ -f /etc/sudoers ]; then
            sed -i 's/^#\s*%wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers
            sed -i 's/^#\s*%wheel ALL=(ALL) ALL/%wheel ALL=(ALL) ALL/' /etc/sudoers
            sed -i 's/^#\s*#includedir \/etc\/sudoers.d/#includedir \/etc\/sudoers.d/' /etc/sudoers
            grep -q "^#includedir /etc/sudoers.d" /etc/sudoers || echo "#includedir /etc/sudoers.d" >> /etc/sudoers
        fi

        if [ "${nopasswd}" = "1" ]; then
            mkdir -p /etc/sudoers.d
            echo "${username} ALL=(ALL:ALL) NOPASSWD: ALL" > "/etc/sudoers.d/${username}"
            chmod 0440 "/etc/sudoers.d/${username}"
            echo "Configured /etc/sudoers.d/${username} with NOPASSWD: ALL"
        fi
        
        dialog --backtitle "${apptitle}" --title "Success" --msgbox "${txtusersuccess//%1/${username}}" 0 0
    fi
}

# --------------------------------------------------------
# Helpers: AUR & Kernel DKMS
# --------------------------------------------------------
check_regular_user(){
    target_user=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' /etc/passwd | head -n 1)
    if [ -z "${target_user}" ]; then
        dialog --backtitle "${apptitle}" --title "Error" --msgbox "${txtuserrequired}" 0 0
        return 1
    fi
    return 0
}

install_kernel_headers_and_dkms(){
    echo "Checking and installing DKMS and matching kernel headers..."
    local headers_pkgs="dkms"
    for k in linux linux-lts linux-zen linux-hardened; do
        if pacman -Q "$k" &>/dev/null; then
            headers_pkgs+=" ${k}-headers"
        fi
    done
    if [ "$headers_pkgs" = "dkms" ]; then
        headers_pkgs="dkms linux-headers"
    fi
    pacman -S --needed --noconfirm ${headers_pkgs}
}

install_yay(){
    local user="${1}"
    if command -v yay &>/dev/null; then
        echo "yay is already installed."
        return 0
    fi

    echo "Ensuring build prerequisites (base-devel, git, sudo)..."
    pacman -S --needed --noconfirm base-devel git sudo

    chmod 1777 /tmp

    local sudoers_temp="/etc/sudoers.d/99-installer-temp"
    local had_temp_sudoers=0
    if [ ! -f "/etc/sudoers.d/${user}" ]; then
        mkdir -p /etc/sudoers.d
        echo "${user} ALL=(ALL:ALL) NOPASSWD: ALL" > "${sudoers_temp}"
        chmod 0440 "${sudoers_temp}"
        had_temp_sudoers=1
    fi

    echo "Building and installing yay-bin as user ${user}..."
    su - "${user}" -c "rm -rf /tmp/yay-bin && git clone https://aur.archlinux.org/yay-bin.git /tmp/yay-bin && cd /tmp/yay-bin && makepkg -si --noconfirm && rm -rf /tmp/yay-bin"
    local res=$?

    if [ "${had_temp_sudoers}" = "1" ]; then
        rm -f "${sudoers_temp}"
    fi

    if [ ${res} -eq 0 ]; then
        echo "yay installed successfully!"
    else
        echo "Error: Failed to install yay."
    fi
    return ${res}
}

install_aur_pkgs(){
    local user="${1}"
    shift
    local pkgs="$@"

    if ! command -v yay &>/dev/null; then
        echo "yay is required for AUR packages. Installing yay-bin first..."
        install_yay "${user}" || return 1
    fi

    local sudoers_temp="/etc/sudoers.d/99-installer-temp"
    local had_temp_sudoers=0
    if [ ! -f "/etc/sudoers.d/${user}" ]; then
        mkdir -p /etc/sudoers.d
        echo "${user} ALL=(ALL:ALL) NOPASSWD: ALL" > "${sudoers_temp}"
        chmod 0440 "${sudoers_temp}"
        had_temp_sudoers=1
    fi

    echo "Installing ${pkgs} from AUR using yay (user: ${user})..."
    su - "${user}" -c "yay -S --needed --noconfirm ${pkgs}"
    local res=$?

    if [ "${had_temp_sudoers}" = "1" ]; then
        rm -f "${sudoers_temp}"
    fi

    return ${res}
}

