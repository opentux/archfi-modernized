# --------------------------------------------------------
# Module: System Services
# --------------------------------------------------------
menu_services(){
    options=()
    options+=("bluetooth" "Bluetooth support (bluez)" on)
    options+=("cups" "Printing support (CUPS)" on)
    options+=("fstrim" "SSD/NVMe periodic TRIM timer" on)
    options+=("ufw" "Uncomplicated Firewall" off)
    
    sel=$(dialog --backtitle "${apptitle}" --title "${txtservicestitle}" --checklist "${txtservicesdesc}" 0 0 0 \
        "${options[@]}" \
        3>&1 1>&2 2>&3)
        
    if [ "$?" = "0" ]; then
        clear
        for srv in ${sel}; do
            clean_srv=$(echo ${srv} | sed 's/"//g')
            case ${clean_srv} in
                "bluetooth")
                    echo "Enabling Bluetooth..."
                    pacman -S --needed --noconfirm bluez bluez-utils
                    systemctl enable bluetooth.service
                ;;
                "cups")
                    echo "Enabling Printing (CUPS)..."
                    pacman -S --needed --noconfirm cups cups-pdf
                    systemctl enable cups.service
                ;;
                "fstrim")
                    echo "Enabling SSD fstrim.timer..."
                    systemctl enable fstrim.timer
                ;;
                "ufw")
                    echo "Enabling Firewall (ufw)..."
                    pacman -S --needed --noconfirm ufw
                    systemctl enable ufw.service
                    ufw default deny incoming
                    ufw default allow outgoing
                ;;
            esac
        done
        pressanykey
    fi
}

