# --------------------------------------------------------
# Module: Pacman Optimization & Multilib
# --------------------------------------------------------
optimize_pacman(){
    local conf="${1:-/etc/pacman.conf}"
    if [ -f "$conf" ]; then
        # Enable Color
        sed -i 's/^#Color/Color/' "$conf"
        grep -q "^Color" "$conf" || sed -i '/^#Misc options/a Color' "$conf"
        
        # Enable ILoveCandy
        grep -q "ILoveCandy" "$conf" || sed -i '/Color/a ILoveCandy' "$conf"
        
        # Enable VerbosePkgLists
        sed -i 's/^#VerbosePkgLists/VerbosePkgLists/' "$conf"
        
        # Set ParallelDownloads = 10
        if grep -q "ParallelDownloads" "$conf"; then
            sed -i 's/.*ParallelDownloads.*/ParallelDownloads = 10/' "$conf"
        else
            sed -i '/^Color/a ParallelDownloads = 10' "$conf"
        fi
        
        # Enable multilib
        if grep -q "^#\[multilib\]" "$conf"; then
            sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' "$conf"
        elif ! grep -q "^\[multilib\]" "$conf"; then
            cat << 'EOF' >> "$conf"

[multilib]
Include = /etc/pacman.d/mirrorlist
EOF
        fi
    fi
}

menu_pacman(){
    if dialog --backtitle "${apptitle}" --title "${txtpacmantitle}" --yesno "${txtpacmandesc}" 0 0; then
        clear
        echo "Optimizing /etc/pacman.conf (Color, ILoveCandy, ParallelDownloads=10, Multilib)..."
        optimize_pacman "/etc/pacman.conf"
        echo "Refreshing Pacman database with multilib..."
        pacman -Sy
        dialog --backtitle "${apptitle}" --title "Success" --msgbox "${txtpacmansuccess}" 0 0
    fi
}

# --------------------------------------------------------
# Module: User Management
# --------------------------------------------------------
menu_user(){
    username=$(dialog --backtitle "${apptitle}" --title "${txtusermenu}" --inputbox "${txtusernameprompt}" 0 0 3>&1 1>&2 2>&3)
    if [ "$?" = "0" ] && [ -n "${username}" ]; then
        if id "${username}" &>/dev/null; then
            dialog --backtitle "${apptitle}" --title "Error" --msgbox "User ${username} already exists!" 0 0
            return 1
        fi

        local nopasswd="0"
        if (dialog --backtitle "${apptitle}" --title "${txtusermenu}" --yesno "${txtusersudoersnopasswd//%1/${username}}" 0 0); then
            nopasswd="1"
        fi

        clear
        echo "Installing sudo..."
        pacman -S --needed --noconfirm sudo
        echo "Creating user ${username}..."
        useradd -m -G wheel -s /bin/bash "${username}"
        echo "Please set password for ${username}:"
        passwd "${username}"
        
        # Configure sudoers for wheel
        if [ -f /etc/sudoers ]; then
            sed -i 's/^#\s*%wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers
            sed -i 's/^#\s*%wheel ALL=(ALL) ALL/%wheel ALL=(ALL) ALL/' /etc/sudoers
            sed -i 's/^#\s*#includedir \/etc\/sudoers.d/#includedir \/etc\/sudoers.d/' /etc/sudoers
            grep -q "^#includedir /etc/sudoers.d" /etc/sudoers || echo "#includedir /etc/sudoers.d" >> /etc/sudoers
        fi

        if [ "${nopasswd}" = "1" ]; then
            mkdir -p /etc/sudoers.d
            echo "${username} ALL=(ALL:ALL) NOPASSWD: ALL" > "/etc/sudoers.d/${username}"
            chmod 0440 "/etc/sudoers.d/${username}"
            echo "Configured /etc/sudoers.d/${username} with NOPASSWD: ALL"
        fi

        if [ -f /etc/xdg/kxkbrc ]; then
            mkdir -p "/home/${username}/.config"
            cp /etc/xdg/kxkbrc "/home/${username}/.config/kxkbrc"
            chown -R "${username}" "/home/${username}/.config" 2>/dev/null || true
        fi
        if [ -f /etc/xdg/plasma-localerc ]; then
            mkdir -p "/home/${username}/.config"
            cp /etc/xdg/plasma-localerc "/home/${username}/.config/plasma-localerc"
            chown -R "${username}" "/home/${username}/.config" 2>/dev/null || true
        fi
        
        dialog --backtitle "${apptitle}" --title "Success" --msgbox "${txtusersuccess//%1/${username}}" 0 0
    fi
}

# --------------------------------------------------------
# Helpers: Keyboard Layout Configuration
# --------------------------------------------------------
configure_system_keymap(){
    local kbd_layout="us"
    if [ -f /etc/vconsole.conf ] && grep -qi "KEYMAP=.*fr" /etc/vconsole.conf; then
        kbd_layout="fr"
    elif [[ "$LANG" =~ ^fr ]] || [ "${lang}" = "fr" ]; then
        kbd_layout="fr"
    fi

    echo "Configuring graphical and session keyboard layout (${kbd_layout})..."

    # 1. System-wide X11 & Display Managers (SDDM, GDM, LightDM)
    mkdir -p /etc/X11/xorg.conf.d
    cat << EOF > /etc/X11/xorg.conf.d/00-keyboard.conf
# Written by archdi
Section "InputClass"
        Identifier "system-keyboard"
        MatchIsKeyboard "on"
        Option "XkbLayout" "${kbd_layout}"
        Option "XkbModel" "pc105"
EndSection
EOF

    # 2. Systemd localectl (applies to systemd-localed & Wayland compositors)
    localectl set-x11-keymap "${kbd_layout}" pc105 2>/dev/null || true
    if [ "${kbd_layout}" = "fr" ]; then
        localectl set-keymap fr 2>/dev/null || true
    fi

    # 3. KDE Plasma 6 (system-wide kxkbrc & user configs for Wayland and X11)
    mkdir -p /etc/xdg
    cat << EOF > /etc/xdg/kxkbrc
[Layout]
DisplayNames=
IncludeLabel=true
LayoutList=${kbd_layout}
LayoutLoopCount=1
Model=pc105
ResetOldOptions=false
ShowFlag=false
ShowLabel=true
ShowLayoutIndicator=true
ShowSingle=false
SwitchMode=Global
Use=true
VariantList=
EOF

    mkdir -p /etc/skel/.config
    cp /etc/xdg/kxkbrc /etc/skel/.config/kxkbrc 2>/dev/null || true

    for u_home in /home/*; do
        if [ -d "${u_home}" ]; then
            local u_name
            u_name=$(basename "${u_home}")
            mkdir -p "${u_home}/.config"
            cp /etc/xdg/kxkbrc "${u_home}/.config/kxkbrc"
            chown -R "${u_name}" "${u_home}/.config" 2>/dev/null || true
        fi
    done

    # 4. SDDM Xsetup script (for SDDM X11 greeter)
    if [ -d /usr/share/sddm/scripts ]; then
        if [ -f /usr/share/sddm/scripts/Xsetup ]; then
            grep -q "setxkbmap" /usr/share/sddm/scripts/Xsetup || echo "setxkbmap ${kbd_layout} 2>/dev/null || true" >> /usr/share/sddm/scripts/Xsetup
        fi
    fi

    # 5. GNOME & GDM Wayland (dconf system-wide override for Mutter & GDM)
    mkdir -p /etc/dconf/profile /etc/dconf/db/local.d
    if [ ! -f /etc/dconf/profile/user ]; then
        cat << 'EOF' > /etc/dconf/profile/user
user-db:user
system-db:local
EOF
    fi
    cat << EOF > /etc/dconf/db/local.d/00-keyboard
[org/gnome/desktop/input-sources]
sources=[('xkb', '${kbd_layout}')]
mru-sources=[('xkb', '${kbd_layout}')]
EOF
    dconf update 2>/dev/null || true
}

configure_system_locale(){
    local sys_lang="${lang:-en}"
    if [ -f /etc/locale.conf ] && grep -qi "LANG=.*fr" /etc/locale.conf; then
        sys_lang="fr"
    elif [[ "$LANG" =~ ^fr ]]; then
        sys_lang="fr"
    fi

    if [ "${sys_lang}" = "fr" ]; then
        echo "Configuring French system locale, Plasma translations and spell-checker..."
        # 1. /etc/locale.gen
        if [ -f /etc/locale.gen ]; then
            sed -i 's/^#\(fr_FR.UTF-8 UTF-8\)/\1/' /etc/locale.gen
            sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
            locale-gen 2>/dev/null || true
        fi

        # 2. /etc/locale.conf
        cat << 'EOF' > /etc/locale.conf
LANG=fr_FR.UTF-8
LC_COLLATE=C
EOF
        export LANG=fr_FR.UTF-8

        # 3. KDE Plasma 6 French translations in /etc/xdg/plasma-localerc
        mkdir -p /etc/xdg /etc/skel/.config
        cat << 'EOF' > /etc/xdg/plasma-localerc
[Formats]
LANG=fr_FR.UTF-8

[Translations]
LANGUAGE=fr_FR:fr
EOF
        cp /etc/xdg/plasma-localerc /etc/skel/.config/plasma-localerc 2>/dev/null || true
        for udir in /home/*; do
            if [ -d "${udir}" ]; then
                local u=$(basename "${udir}")
                mkdir -p "${udir}/.config"
                cp /etc/xdg/plasma-localerc "${udir}/.config/plasma-localerc"
                chown -R "${u}" "${udir}/.config" 2>/dev/null || true
            fi
        done

        # 4. French dictionaries and tools
        pacman -S --needed --noconfirm hunspell-fr 2>/dev/null || true
    fi
}

append_kernel_cmdline(){
    local params="$1"
    # 1. GRUB (/etc/default/grub)
    if [ -f /etc/default/grub ]; then
        local grub_changed=0
        for p in ${params}; do
            if ! grep "^GRUB_CMDLINE_LINUX_DEFAULT=" /etc/default/grub | grep -q "${p}"; then
                sed -i "s/^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"/GRUB_CMDLINE_LINUX_DEFAULT=\"\1 ${p}\"/" /etc/default/grub
                sed -i 's/  */ /g' /etc/default/grub
                grub_changed=1
            fi
        done
        if [ "${grub_changed}" = "1" ] && [ -f /boot/grub/grub.cfg ] && command -v grub-mkconfig >/dev/null 2>&1; then
            echo "Updating GRUB configuration (/boot/grub/grub.cfg)..."
            grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || true
        fi
    fi

    # 2. systemd-boot (/boot/loader/entries/*.conf)
    if [ -d /boot/loader/entries ]; then
        for entry in /boot/loader/entries/*.conf; do
            if [ -f "${entry}" ]; then
                for p in ${params}; do
                    if grep -q "^options " "${entry}" && ! grep "^options " "${entry}" | grep -q "${p}"; then
                        sed -i "s/^options \(.*\)/options \1 ${p}/" "${entry}"
                    fi
                done
            fi
        done
    fi

    # 3. rEFInd (/boot/refind_linux.conf)
    if [ -f /boot/refind_linux.conf ]; then
        for p in ${params}; do
            if ! grep -q "${p}" /boot/refind_linux.conf; then
                sed -i "s/\"rw /\"rw ${p} /g" /boot/refind_linux.conf
            fi
        done
    fi
}

configure_nvidia_mkinitcpio(){
    echo "Installing NVIDIA Wayland VA-API video acceleration (libva-nvidia-driver, libva-utils)..."
    pacman -S --needed --noconfirm libva-nvidia-driver libva-utils 2>/dev/null || true

    echo "Configuring NVIDIA DRM KMS, Wayland fbdev and video memory preservation in /etc/modprobe.d/nvidia.conf..."
    mkdir -p /etc/modprobe.d
    cat << 'EOF' > /etc/modprobe.d/nvidia.conf
options nvidia_drm modeset=1 fbdev=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp
EOF

    echo "Enabling NVIDIA suspend/hibernate/resume and laptop Dynamic Boost services..."
    for nv_srv in nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service nvidia-powerd.service; do
        systemctl enable "${nv_srv}" 2>/dev/null || true
    done

    append_kernel_cmdline "nvidia-drm.modeset=1 nvidia-drm.fbdev=1"

    local mkconf="/etc/mkinitcpio.conf"
    if [ -f "${mkconf}" ]; then
        if ! grep -q "nvidia" "${mkconf}"; then
            echo "Adding NVIDIA modules to ${mkconf}..."
            if grep -q "^MODULES=" "${mkconf}"; then
                sed -i 's/^MODULES=(\(.*\))/MODULES=(\1 nvidia nvidia_modeset nvidia_uvm nvidia_drm)/' "${mkconf}"
                sed -i 's/  */ /g' "${mkconf}"
            else
                echo "MODULES=(nvme nvidia nvidia_modeset nvidia_uvm nvidia_drm)" >> "${mkconf}"
            fi
        fi
        echo "Regenerating initramfs for NVIDIA early KMS loading..."
        mkinitcpio -P
    fi
}

# --------------------------------------------------------
# Helpers: AUR & Kernel DKMS
# --------------------------------------------------------
check_regular_user(){
    target_user=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' /etc/passwd | head -n 1)
    if [ -z "${target_user}" ]; then
        dialog --backtitle "${apptitle}" --title "Error" --msgbox "${txtuserrequired}" 0 0
        return 1
    fi
    return 0
}

install_kernel_headers_and_dkms(){
    echo "Checking and installing DKMS and matching kernel headers..."
    local headers_pkgs="dkms"
    for k in linux linux-lts linux-zen linux-hardened linux-cachyos; do
        if pacman -Q "$k" &>/dev/null; then
            headers_pkgs+=" ${k}-headers"
        fi
    done
    if [ "$headers_pkgs" = "dkms" ]; then
        headers_pkgs="dkms linux-headers"
    fi
    pacman -S --needed --noconfirm ${headers_pkgs}
}

install_yay(){
    local user="${1}"
    if command -v yay &>/dev/null; then
        echo "yay is already installed."
        return 0
    fi

    echo "Ensuring build prerequisites (base-devel, git, sudo)..."
    pacman -S --needed --noconfirm base-devel git sudo

    chmod 1777 /tmp

    local sudoers_temp="/etc/sudoers.d/99-installer-temp"
    local had_temp_sudoers=0
    if [ ! -f "/etc/sudoers.d/${user}" ]; then
        mkdir -p /etc/sudoers.d
        echo "${user} ALL=(ALL:ALL) NOPASSWD: ALL" > "${sudoers_temp}"
        chmod 0440 "${sudoers_temp}"
        had_temp_sudoers=1
    fi

    echo "Building and installing yay-bin as user ${user}..."
    su - "${user}" -c "rm -rf /tmp/yay-bin && git clone https://aur.archlinux.org/yay-bin.git /tmp/yay-bin && cd /tmp/yay-bin && makepkg -si --noconfirm && rm -rf /tmp/yay-bin"
    local res=$?

    if [ "${had_temp_sudoers}" = "1" ]; then
        rm -f "${sudoers_temp}"
    fi

    if [ ${res} -eq 0 ]; then
        echo "yay installed successfully!"
    else
        echo "Error: Failed to install yay."
    fi
    return ${res}
}

install_aur_pkgs(){
    local user="${1}"
    shift
    local pkgs="$@"

    if ! command -v yay &>/dev/null; then
        echo "yay is required for AUR packages. Installing yay-bin first..."
        install_yay "${user}" || return 1
    fi

    local sudoers_temp="/etc/sudoers.d/99-installer-temp"
    local had_temp_sudoers=0
    if [ ! -f "/etc/sudoers.d/${user}" ]; then
        mkdir -p /etc/sudoers.d
        echo "${user} ALL=(ALL:ALL) NOPASSWD: ALL" > "${sudoers_temp}"
        chmod 0440 "${sudoers_temp}"
        had_temp_sudoers=1
    fi

    echo "Installing ${pkgs} from AUR using yay (user: ${user})..."
    su - "${user}" -c "yay -S --needed --noconfirm ${pkgs}"
    local res=$?

    if [ "${had_temp_sudoers}" = "1" ]; then
        rm -f "${sudoers_temp}"
    fi

    return ${res}
}

