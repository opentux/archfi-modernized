                    pacman_pkgs="${pacman_pkgs} ${clean_pkg}"
                ;;
            esac
        done

        if [ -n "${pacman_pkgs}" ]; then
            echo "Installing applications:${pacman_pkgs}..."
            pacman -S --needed --noconfirm ${pacman_pkgs}
        fi

        if [ -n "${aur_pkgs}" ]; then
            if check_regular_user; then
