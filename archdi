                    echo "Enabling NetworkManager & WiFi..."
                    pacman -S --needed --noconfirm networkmanager iwd wireless-regdb
                    systemctl enable NetworkManager.service
                    systemctl start NetworkManager.service 2>/dev/null || true
                ;;
                "bluetooth")
                    echo "Enabling Bluetooth..."
                    pacman -S --needed --noconfirm bluez bluez-utils
                    systemctl enable bluetooth.service
                ;;
                "cups")
                    echo "Enabling Printing (CUPS)..."
                    pacman -S --needed --noconfirm cups cups-pdf
                    systemctl enable cups.service
                ;;
                "fstrim")
                    echo "Enabling SSD fstrim.timer..."
                    systemctl enable fstrim.timer
                ;;
                "zram")
                    cachyos_configure_zram
                ;;
                "paccache")
                    echo "Enabling Pacman cache auto-cleanup (paccache.timer)..."
                    pacman -S --needed --noconfirm pacman-contrib
                    systemctl enable paccache.timer 2>/dev/null || true
                ;;
                "flatpak")
                    echo "Installing Flatpak and enabling Flathub repository..."
                    pacman -S --needed --noconfirm flatpak
                    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
                    if pacman -Q plasma-desktop &>/dev/null; then
                        pacman -S --needed --noconfirm discover flatpak-kcm 2>/dev/null || true
                    elif pacman -Q gnome-shell &>/dev/null; then
                        pacman -S --needed --noconfirm gnome-software 2>/dev/null || true
                    fi
                ;;
                "snapper")
                    echo "Installing Btrfs Snapshots tooling (snapper, snap-pac, btrfs-assistant)..."
                    pacman -S --needed --noconfirm snapper snap-pac btrfs-assistant 2>/dev/null || \
                    pacman -S --needed --noconfirm snapper snap-pac 2>/dev/null || true
                    systemctl enable snapper-timeline.timer 2>/dev/null || true
                    systemctl enable snapper-cleanup.timer 2>/dev/null || true
                ;;
                "ufw")
                    echo "Enabling Firewall (ufw)..."
                    pacman -S --needed --noconfirm ufw
                    systemctl enable ufw.service
                    ufw default deny incoming
                    ufw default allow outgoing
                ;;
            esac
        done
        pressanykey
    fi
}

# --------------------------------------------------------
# Module: TUXEDO Laptop Support
# --------------------------------------------------------
tuxedo_apply_power_management(){
    echo "Disabling and masking conflicting power management services..."
    for srv in power-profiles-daemon.service tuned.service tuned-ppd.service tlp.service auto-cpufreq.service; do
        systemctl stop "${srv}" 2>/dev/null || true
        systemctl disable "${srv}" 2>/dev/null || true
        systemctl mask "${srv}" 2>/dev/null || true
    done

    echo "Enabling TUXEDO Control Center daemon (tccd)..."
    systemctl unmask tccd.service 2>/dev/null || true
    systemctl enable tccd.service 2>/dev/null || true
    systemctl start tccd.service 2>/dev/null || true

    systemctl unmask tccd-sleep.service 2>/dev/null || true
    systemctl enable tccd-sleep.service 2>/dev/null || true
    systemctl start tccd-sleep.service 2>/dev/null || true
}

tuxedo_restore_power_management(){
    echo "Disabling TUXEDO Control Center daemon..."
    systemctl stop tccd.service 2>/dev/null || true
    systemctl disable tccd.service 2>/dev/null || true
    systemctl stop tccd-sleep.service 2>/dev/null || true
    systemctl disable tccd-sleep.service 2>/dev/null || true

    echo "Unmasking and restoring standard power services..."
    for srv in power-profiles-daemon.service tuned.service tuned-ppd.service tlp.service auto-cpufreq.service; do
        systemctl unmask "${srv}" 2>/dev/null || true
    done
    systemctl enable power-profiles-daemon.service 2>/dev/null || true
    systemctl start power-profiles-daemon.service 2>/dev/null || true
}

