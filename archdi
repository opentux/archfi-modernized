# --------------------------------------------------------
# Module: AUR Helper
# --------------------------------------------------------
menu_aur(){
    options=()
    options+=("yay-bin" "yay (Precompiled binary - Fast)")
    options+=("paru-bin" "paru (Rust-based helper - Precompiled)")
    
    sel=$(dialog --backtitle "${apptitle}" --title "${txtaurtitle}" --menu "${txtaurdesc}" 0 0 0 \
        "${options[@]}" \
        3>&1 1>&2 2>&3)
        
    if [ "$?" = "0" ]; then
        # Check non-root user
        regular_users=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' /etc/passwd)
        if [ -z "${regular_users}" ]; then
            dialog --backtitle "${apptitle}" --title "Error" --msgbox "Please create a standard user first before installing an AUR helper!" 0 0
            return 1
        fi
        
        target_user=$(echo "${regular_users}" | head -n 1)
        clear
        echo "Installing prerequisites (base-devel, git)..."
        pacman -S --needed --noconfirm base-devel git
        
        echo "Building and installing ${sel} as user ${target_user}..."
        su - "${target_user}" -c "rm -rf /tmp/${sel} && git clone https://aur.archlinux.org/${sel}.git /tmp/${sel} && cd /tmp/${sel} && makepkg -si --noconfirm && rm -rf /tmp/${sel}"
        
        pressanykey
    fi
}

# --------------------------------------------------------
# Main Menu
# --------------------------------------------------------
mainmenu(){
    local default_item="."
    while true; do
        options=()
        options+=("1" "${txtlangmenu}")
        options+=("2" "${txtpacmanmenu}")
        options+=("3" "${txtusermenu}")
        options+=("4" "${txtgpumenu}")
        options+=("5" "${txtaudiomenu}")
        options+=("6" "${txtdemenu}")
        options+=("7" "${txtfontsmenu}")
        options+=("8" "${txtservicesmenu}")
        options+=("9" "${txtappsmenu}")
        options+=("10" "${txtaurmenu}")
        options+=("11" "${txtreboot}")
        
        sel=$(dialog --backtitle "${apptitle}" --title "${txtmainmenu}" \
            --cancel-button "${txtexit}" --default-item "${default_item}" \
            --menu "" 0 0 0 \
            "${options[@]}" \
            3>&1 1>&2 2>&3)
            
        if [ "$?" != "0" ]; then
            clear
            break
        fi
        
        case ${sel} in
            "1") menu_language; default_item="2";;
            "2") menu_pacman; default_item="3";;
            "3") menu_user; default_item="4";;
            "4") menu_gpu; default_item="5";;
            "5") menu_audio; default_item="6";;
            "6") menu_de; default_item="7";;
            "7") menu_fonts; default_item="8";;
            "8") menu_services; default_item="9";;
            "9") menu_apps; default_item="10";;
            "10") menu_aur; default_item="11";;
            "11")
                if dialog --backtitle "${apptitle}" --title "${txtreboot}" --yesno "${txtreboot} ?" 0 0; then
                    clear
                    reboot
                    break
                fi
            ;;
        esac
    done
}

# --------------------------------------------------------
# Command line arguments / Entry Point
# --------------------------------------------------------
case "${1}" in
    "-i" | "--install")
        echo "Installing archdi to /usr/local/bin/archdi..."
        chmod 755 "${0}"
        cp "${0}" /usr/local/bin/archdi
        echo "archdi is installed. Type 'archdi' to launch."
        exit 0
    ;;
    "-h" | "--help")
        echo "Arch Linux Desktop Install (archdi)"
        echo "Usage: archdi [options]"
        echo "  -i, --install    Install archdi to /usr/local/bin/archdi"
        echo "  -h, --help       Show this help"
        exit 0
    ;;
    *)
        mainmenu
    ;;
esac

exit 0
