                echo "Installing LibreOffice French language pack (libreoffice-fresh-fr)..."
                pacman -S --needed --noconfirm libreoffice-fresh-fr 2>/dev/null || true
            fi
            pacman -S --needed --noconfirm hunspell-fr 2>/dev/null || true
        fi

        if [[ "${pacman_pkgs}" == *"fastfetch"* ]] || command -v fastfetch &>/dev/null; then
            configure_fastfetch_bashrc
        fi

        pressanykey
    fi
}

