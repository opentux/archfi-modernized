# --------------------------------------------------------
# Module: CachyOS Repository, Kernel & System Tweaks
# --------------------------------------------------------
cachyos_enable_repo(){
    echo "=== Enabling CachyOS Repository ==="
    echo "Detecting CPU architecture..."
    local cachy_arch="standard"
    if /usr/lib/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q "x86-64-v4 (supported"; then
        cachy_arch="v4"
    elif /usr/lib/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q "x86-64-v3 (supported"; then
        cachy_arch="v3"
    elif grep -q "avx512f" /proc/cpuinfo 2>/dev/null && grep -q "avx512bw" /proc/cpuinfo 2>/dev/null; then
        cachy_arch="v4"
    elif grep -q "avx2" /proc/cpuinfo 2>/dev/null && grep -q "bmi2" /proc/cpuinfo 2>/dev/null; then
        cachy_arch="v3"
    fi
    echo "Detected CPU architecture level: ${cachy_arch}"

    echo "Importing CachyOS signing key..."
    pacman-key --recv-keys F3B607488DB35A47 --keyserver keyserver.ubuntu.com 2>/dev/null || \
    pacman-key --recv-keys F3B607488DB35A47 --keyserver hkps://keyserver.ubuntu.com 2>/dev/null || true
    pacman-key --lsign-key F3B607488DB35A47 2>/dev/null || true

    echo "Setting up CachyOS mirrorlists in /etc/pacman.d/..."
    mkdir -p /etc/pacman.d
    cat << 'EOF' > /etc/pacman.d/cachyos-mirrorlist
Server = https://mirror.cachyos.org/repo/x86_64/$repo
Server = https://fastmirror.cachyos.org/repo/x86_64/$repo
Server = https://in-mirror.cachyos.org/repo/x86_64/$repo
Server = https://cdn77.cachyos.org/repo/x86_64/$repo
EOF

    case "${cachy_arch}" in
        "v4")
            cat << 'EOF' > /etc/pacman.d/cachyos-v4-mirrorlist
Server = https://mirror.cachyos.org/repo/x86_64_v4/$repo
Server = https://fastmirror.cachyos.org/repo/x86_64_v4/$repo
Server = https://in-mirror.cachyos.org/repo/x86_64_v4/$repo
Server = https://cdn77.cachyos.org/repo/x86_64_v4/$repo
EOF
            cat << 'EOF' > /tmp/cachyos-repos.conf
[cachyos-v4]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v4-mirrorlist

[cachyos-core-v4]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v4-mirrorlist

[cachyos-extra-v4]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v4-mirrorlist

[cachyos]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-mirrorlist

EOF
        ;;
        "v3")
            cat << 'EOF' > /etc/pacman.d/cachyos-v3-mirrorlist
Server = https://mirror.cachyos.org/repo/x86_64_v3/$repo
Server = https://fastmirror.cachyos.org/repo/x86_64_v3/$repo
Server = https://in-mirror.cachyos.org/repo/x86_64_v3/$repo
Server = https://cdn77.cachyos.org/repo/x86_64_v3/$repo
EOF
            cat << 'EOF' > /tmp/cachyos-repos.conf
[cachyos-v3]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos-core-v3]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos-extra-v3]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-mirrorlist

EOF
        ;;
        *)
            cat << 'EOF' > /tmp/cachyos-repos.conf
[cachyos]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-mirrorlist

[cachyos-core]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-mirrorlist

[cachyos-extra]
SigLevel = PackageRequired
Include = /etc/pacman.d/cachyos-mirrorlist

EOF
        ;;
    esac

    echo "Configuring allowed CPU architectures in /etc/pacman.conf..."
    case "${cachy_arch}" in
        "v4")
            sed -i 's/^#*Architecture\s*=.*/Architecture = auto x86_64 x86_64_v3 x86_64_v4/' /etc/pacman.conf
        ;;
        "v3")
            sed -i 's/^#*Architecture\s*=.*/Architecture = auto x86_64 x86_64_v3/' /etc/pacman.conf
        ;;
        *)
            sed -i 's/^#*Architecture\s*=.*/Architecture = auto x86_64/' /etc/pacman.conf
        ;;
    esac

    echo "Adding CachyOS repository sections to /etc/pacman.conf..."
    sed -i '/^\[cachyos/,/^\[core\]/{ /^\[core\]/!d }' /etc/pacman.conf 2>/dev/null || true
    sed -i '/^\[core\]/e cat /tmp/cachyos-repos.conf' /etc/pacman.conf
    rm -f /tmp/cachyos-repos.conf

    echo "Refreshing package databases..."
    pacman -Sy
    echo "Installing CachyOS keyring and mirrorlist packages..."
    local mirrorlist_pkgs="cachyos-mirrorlist"
    if [ "${cachy_arch}" = "v4" ]; then
        mirrorlist_pkgs="cachyos-mirrorlist cachyos-v4-mirrorlist"
    elif [ "${cachy_arch}" = "v3" ]; then
        mirrorlist_pkgs="cachyos-mirrorlist cachyos-v3-mirrorlist"
    fi
    pacman -S --needed --noconfirm cachyos-keyring ${mirrorlist_pkgs} 2>/dev/null || true
    sed -i 's|/\$arch_v3/|/x86_64_v3/|g; s|/\$arch/|/x86_64_v3/|g' /etc/pacman.d/cachyos-v3-mirrorlist 2>/dev/null || true
    sed -i 's|/\$arch_v4/|/x86_64_v4/|g; s|/\$arch/|/x86_64_v4/|g' /etc/pacman.d/cachyos-v4-mirrorlist 2>/dev/null || true
}

cachyos_install_kernel_and_settings(){
    cachyos_enable_repo
    echo "=== Installing linux-cachyos, linux-cachyos-headers & cachyos-settings ==="
    pacman -S --needed --noconfirm linux-cachyos linux-cachyos-headers cachyos-settings
}

cachyos_apply_io_schedulers(){
    local target_root="${1:-}"
    echo "=== Configuring I/O Schedulers udev rules (/etc/udev/rules.d/60-ioschedulers.rules) ==="
    mkdir -p "${target_root}/etc/udev/rules.d"
    cat << 'EOF' > "${target_root}/etc/udev/rules.d/60-ioschedulers.rules"
# HDD
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="1", \
    ATTR{queue/scheduler}="bfq"

# SSD
ACTION=="add|change", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="0", \
    ATTR{queue/scheduler}="adios"

# NVMe SSD
ACTION=="add|change", KERNEL=="nvme[0-9]*", ATTR{queue/rotational}=="0", \
    ATTR{queue/scheduler}="adios"
EOF
    echo "Rule created: ${target_root}/etc/udev/rules.d/60-ioschedulers.rules"
    if [ -z "${target_root}" ]; then
        udevadm control --reload 2>/dev/null || true
        udevadm trigger 2>/dev/null || true
    fi
}

cachyos_apply_sysctl_tweaks(){
    local target_root="${1:-}"
    echo "=== Configuring Sysctl Tweaks (/etc/sysctl.d/99-splitlock.conf) ==="
    mkdir -p "${target_root}/etc/sysctl.d"
    cat << 'EOF' > "${target_root}/etc/sysctl.d/99-splitlock.conf"
kernel.split_lock_mitigate=0
vm.max_map_count = 2147483642
EOF
    echo "Config created: ${target_root}/etc/sysctl.d/99-splitlock.conf"
    if [ -z "${target_root}" ]; then
        sysctl -p /etc/sysctl.d/99-splitlock.conf 2>/dev/null || true
    fi
}

cachyos_configure_zram(){
    echo "=== Configuring ZRAM Swap in RAM (zram-generator, zstd, swappiness=180) ==="
    pacman -S --needed --noconfirm zram-generator
    mkdir -p /etc/systemd /etc/sysctl.d
    cat << 'EOF' > /etc/systemd/zram-generator.conf
[zram0]
zram-size = ram
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOF
    cat << 'EOF' > /etc/sysctl.d/99-zram.conf
vm.swappiness = 180
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
vm.page-cluster = 0
EOF
    systemctl daemon-reload 2>/dev/null || true
    systemctl start systemd-zram-setup@zram0.service 2>/dev/null || true
    sysctl -p /etc/sysctl.d/99-zram.conf 2>/dev/null || true
    echo "ZRAM Swap configured (/etc/systemd/zram-generator.conf & /etc/sysctl.d/99-zram.conf)."
}

cachyos_install_ananicy(){
    echo "=== Installing ananicy-cpp & CachyOS Process Priority Rules ==="
    pacman -S --needed --noconfirm ananicy-cpp cachyos-ananicy-rules 2>/dev/null || \
    pacman -S --needed --noconfirm ananicy-cpp 2>/dev/null || true
    systemctl enable --now ananicy-cpp.service 2>/dev/null || true
}

cachyos_install_scx(){
    echo "=== Installing Sched-ext BPF CPU Schedulers (scx-scheds: scx_lavd) ==="
    pacman -S --needed --noconfirm scx-scheds 2>/dev/null || true
    if [ -f /etc/default/scx ]; then
        sed -i 's/^SCX_SCHEDULER=.*/SCX_SCHEDULER=scx_lavd/' /etc/default/scx
    else
        echo "SCX_SCHEDULER=scx_lavd" > /etc/default/scx
    fi
    systemctl enable --now scx.service 2>/dev/null || true
    echo "Configured scx.service with scx_lavd scheduler."
}

cachyos_rate_mirrors(){
    echo "=== Optimizing Repository Mirror Speed ==="
    if grep -q "\[cachyos" /etc/pacman.conf; then
        pacman -S --needed --noconfirm cachyos-rate-mirrors 2>/dev/null || true
        if command -v cachyos-rate-mirrors >/dev/null 2>&1; then
            cachyos-rate-mirrors
            sed -i 's|/\$arch_v3/|/x86_64_v3/|g; s|/\$arch/|/x86_64_v3/|g' /etc/pacman.d/cachyos-v3-mirrorlist 2>/dev/null || true
            sed -i 's|/\$arch_v4/|/x86_64_v4/|g; s|/\$arch/|/x86_64_v4/|g' /etc/pacman.d/cachyos-v4-mirrorlist 2>/dev/null || true
            return 0
        fi
    fi
    pacman -S --needed --noconfirm reflector
    reflector --latest 15 --protocol https --sort rate --save /etc/pacman.d/mirrorlist
}

cachyos_optimize_mkinitcpio(){
    local target_root="${1:-}"
    local mkconf="${target_root}/etc/mkinitcpio.conf"

    echo "=== Installing Plymouth and LZ4 ==="
    if [ -z "${target_root}" ]; then
        pacman -S --needed --noconfirm plymouth lz4
    else
        pacstrap "${target_root}" plymouth lz4
    fi

    echo "=== Setting default Plymouth theme to spinner ==="
    mkdir -p "${target_root}/etc/plymouth"
    cat << 'EOF' > "${target_root}/etc/plymouth/plymouthd.conf"
[Daemon]
Theme=spinner
ShowDelay=0
EOF
    if [ -z "${target_root}" ] && command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme spinner 2>/dev/null || true
    fi

    if [ -z "${target_root}" ]; then
        append_kernel_cmdline "quiet splash"
    fi

    echo "=== Configuring ${mkconf} ==="
    if [ -f "${mkconf}" ]; then
        # 1. Modules: nvme + (nvidia if present)
        local modules_list="nvme"
        local has_nvidia="0"
        if pacman -Q nvidia 2>/dev/null || pacman -Q nvidia-open 2>/dev/null || pacman -Q nvidia-dkms 2>/dev/null || pacman -Q nvidia-open-dkms 2>/dev/null || find /usr/lib/modules -name "nvidia.ko*" 2>/dev/null | grep -q "nvidia"; then
            has_nvidia="1"
        fi

        if [ "${has_nvidia}" = "1" ]; then
            modules_list="nvme nvidia nvidia_modeset nvidia_uvm nvidia_drm"
        fi

        if grep -q "^MODULES=" "${mkconf}"; then
            sed -i "s|^MODULES=.*|MODULES=(${modules_list})|" "${mkconf}"
        else
            echo "MODULES=(${modules_list})" >> "${mkconf}"
        fi
        echo "Configured MODULES=(${modules_list})"

        # 2. Hooks: HOOKS=(systemd autodetect microcode modconf kms block filesystems plymouth)
        local hooks_list="systemd autodetect microcode modconf kms block filesystems plymouth"
        if grep -q "encrypt" "${mkconf}" || [ "${luksroot}" = "1" ] || [ "${luksdrive}" = "1" ]; then
            hooks_list="systemd autodetect microcode modconf kms block sd-encrypt filesystems plymouth"
        fi
        if grep -q "^HOOKS=" "${mkconf}"; then
            sed -i "s|^HOOKS=.*|HOOKS=(${hooks_list})|" "${mkconf}"
        else
            echo "HOOKS=(${hooks_list})" >> "${mkconf}"
        fi
        echo "Configured HOOKS=(${hooks_list})"

        # 3. Compression: COMPRESSION="lz4"
        if grep -q "^COMPRESSION=" "${mkconf}"; then
            sed -i 's|^COMPRESSION=.*|COMPRESSION="lz4"|' "${mkconf}"
        elif grep -q "^#COMPRESSION=\"lz4\"" "${mkconf}"; then
            sed -i 's|^#COMPRESSION="lz4"|COMPRESSION="lz4"|' "${mkconf}"
        else
            echo 'COMPRESSION="lz4"' >> "${mkconf}"
        fi

        # 4. Compression Options: COMPRESSION_OPTIONS=(-1)
        if grep -q "^COMPRESSION_OPTIONS=" "${mkconf}"; then
            sed -i 's|^COMPRESSION_OPTIONS=.*|COMPRESSION_OPTIONS=(-1)|' "${mkconf}"
        elif grep -q "^#COMPRESSION_OPTIONS=" "${mkconf}"; then
            sed -i 's|^#COMPRESSION_OPTIONS=.*|COMPRESSION_OPTIONS=(-1)|' "${mkconf}"
        else
            echo 'COMPRESSION_OPTIONS=(-1)' >> "${mkconf}"
        fi

        # 5. Modules Decompress: MODULES_DECOMPRESS="yes"
        if grep -q "^MODULES_DECOMPRESS=" "${mkconf}"; then
            sed -i 's|^MODULES_DECOMPRESS=.*|MODULES_DECOMPRESS="yes"|' "${mkconf}"
        elif grep -q "^#MODULES_DECOMPRESS=" "${mkconf}"; then
            sed -i 's|^#MODULES_DECOMPRESS=.*|MODULES_DECOMPRESS="yes"|' "${mkconf}"
        else
            echo 'MODULES_DECOMPRESS="yes"' >> "${mkconf}"
        fi

        # 6. Rebuild initramfs
        echo "=== Regenerating initramfs (mkinitcpio -P) ==="
        if [ -z "${target_root}" ]; then
            mkinitcpio -P
        else
            archchroot genmkinitcpio
        fi
    fi
}

