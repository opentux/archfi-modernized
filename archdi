                        pacman_pkgs="${pacman_pkgs} google-chrome"
                    else
                        aur_pkgs="${aur_pkgs} google-chrome"
                    fi
                ;;
                "smplayer")
                    pacman_pkgs="${pacman_pkgs} smplayer smplayer-themes smplayer-skins"
                ;;
                "vivaldi")
                    pacman_pkgs="${pacman_pkgs} vivaldi vivaldi-ffmpeg-codecs"
                ;;
